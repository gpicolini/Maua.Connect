{
  "semi": true,
  "singleQuote": true,
  "tabWidth": 4,
  "useTabs": false,
  "trailingComma": "all",
  "overrides": [
    {
      "files": "*.css",
      "options": {
        "tabWidth": 0
      }
    },
    {
      "files": "*.html",
      "options": {
        "printWidth": 160,
        "singleAttributePerLine": false,
        "bracketSameLine": true
      }
    }
  ]
}